let blitzOrder = [], blitzIndex = 0, blitzScore = 0, blitzTimer = null, blitzTimeLeft = 0, blitzAnswered = false;
const BLITZ_SECONDS = 6;

function startBlitz(){
  blitzOrder = shuffle(blitzBank);
  blitzIndex = 0; blitzScore = 0;
  document.getElementById('blitz-live').style.display = 'block';
  document.getElementById('blitz-end').style.display = 'none';
  renderBlitzStatement();
}

function renderBlitzStatement(){
  blitzAnswered = false;
  const item = blitzOrder[blitzIndex];
  document.getElementById('blitz-progress').textContent = `Statement ${blitzIndex+1} of ${blitzOrder.length}`;
  document.getElementById('blitz-score').textContent = `Score: ${blitzScore}`;
  document.getElementById('blitz-statement').textContent = item.s;
  const fb = document.getElementById('blitz-feedback');
  fb.className = 'feedback'; fb.textContent = '';
  document.querySelectorAll('.tf-btn').forEach(b => b.disabled = false);

  blitzTimeLeft = BLITZ_SECONDS * 10;
  updateBlitzBar();
  clearInterval(blitzTimer);
  blitzTimer = setInterval(() => {
    blitzTimeLeft--;
    updateBlitzBar();
    if(blitzTimeLeft <= 0){
      clearInterval(blitzTimer);
      if(!blitzAnswered) answerBlitz(null);
    }
  }, 100);
}

function updateBlitzBar(){
  const pct = Math.max(0, (blitzTimeLeft / (BLITZ_SECONDS*10)) * 100);
  document.getElementById('blitz-bar').style.width = pct + '%';
}

function answerBlitz(choice){
  if(blitzAnswered) return;
  blitzAnswered = true;
  clearInterval(blitzTimer);
  document.querySelectorAll('.tf-btn').forEach(b => b.disabled = true);
  const item = blitzOrder[blitzIndex];
  const fb = document.getElementById('blitz-feedback');
  if(choice === item.t){
    blitzScore++;
    fb.className = 'feedback show good';
    fb.textContent = "✔ Correct!";
  } else if(choice === null){
    fb.className = 'feedback show bad';
    fb.textContent = `⏱ Time's up! The answer was ${item.t ? 'TRUE' : 'FALSE'}.`;
  } else {
    fb.className = 'feedback show bad';
    fb.textContent = `✘ Actually ${item.t ? 'TRUE' : 'FALSE'}.`;
  }
  document.getElementById('blitz-score').textContent = `Score: ${blitzScore}`;
  setTimeout(() => {
    blitzIndex++;
    if(blitzIndex >= blitzOrder.length){
      document.getElementById('blitz-live').style.display = 'none';
      document.getElementById('blitz-end').style.display = 'block';
      document.getElementById('blitz-end-text').textContent = `You scored ${blitzScore} out of ${blitzOrder.length}.`;
    } else {
      renderBlitzStatement();
    }
  }, 1200);
}

