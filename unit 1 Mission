let quizOrder = [], quizIndex = 0, quizScore = 0, quizAnswered = false;

function startQuiz(){
  quizOrder = shuffle(quizBank);
  quizIndex = 0; quizScore = 0;
  document.getElementById('quiz-live').style.display = 'block';
  document.getElementById('quiz-end').style.display = 'none';
  renderQuizQuestion();
}

function renderQuizQuestion(){
  quizAnswered = false;
  const item = quizOrder[quizIndex];
  const choiceObjs = item.a.map((text, i) => ({text, correct: i === item.correct}));
  const shuffled = shuffle(choiceObjs);

  document.getElementById('quiz-progress').textContent = `Question ${quizIndex+1} of ${quizOrder.length}`;
  document.getElementById('quiz-score').textContent = `Score: ${quizScore}`;
  document.getElementById('quiz-question').textContent = item.q;

  const list = document.getElementById('quiz-choices');
  list.innerHTML = '';
  shuffled.forEach(c => {
    const btn = document.createElement('button');
    btn.className = 'choice-btn';
    btn.textContent = c.text;
    btn.dataset.isCorrect = c.correct ? 'true' : 'false';
    btn.onclick = () => selectQuizAnswer(btn, c.correct, list);
    list.appendChild(btn);
  });

  const fb = document.getElementById('quiz-feedback');
  fb.className = 'feedback';
  fb.textContent = '';
  document.getElementById('quiz-next').classList.remove('show');
}

function selectQuizAnswer(btn, isCorrect, list){
  if(quizAnswered) return;
  quizAnswered = true;
  list.querySelectorAll('.choice-btn').forEach(b => b.disabled = true);
  const fb = document.getElementById('quiz-feedback');
  if(isCorrect){
    btn.classList.add('correct');
    quizScore++;
    fb.className = 'feedback show good';
    fb.textContent = "✔ Correct!";
  } else {
    btn.classList.add('incorrect');
    fb.className = 'feedback show bad';
    fb.textContent = "✘ Not quite — the correct answer is highlighted below.";
  }
  document.getElementById('quiz-score').textContent = `Score: ${quizScore}`;
  document.getElementById('quiz-next').classList.add('show');
  Array.from(list.children).forEach(b => {
    if(b.dataset.isCorrect === 'true') b.classList.add('correct');
  });
}

function nextQuizQuestion(){
  quizIndex++;
  if(quizIndex >= quizOrder.length){
    document.getElementById('quiz-live').style.display = 'none';
    document.getElementById('quiz-end').style.display = 'block';
    const pct = Math.round((quizScore/quizOrder.length)*100);
    let title = "Nice work!";
    if(pct === 100) title = "Perfect score! 🎉";
    else if(pct >= 80) title = "Great job!";
    else if(pct < 50) title = "Good start — try again!";
    document.getElementById('quiz-end-title').textContent = title;
    document.getElementById('quiz-end-text').textContent = `You scored ${quizScore} out of ${quizOrder.length}.`;
  } else {
    renderQuizQuestion();
  }
}

/* ---------- SORT LAB ---------- */
const sortItems = [
  {name:"Gold", bin:"Element"},
  {name:"Oxygen gas", bin:"Element"},
  {name:"Iron (before rusting)", bin:"Element"},
  {name:"Water (H₂O)", bin:"Compound"},
  {name:"Table Salt (NaCl)", bin:"Compound"},
  {name:"Bronze (copper + tin)", bin:"Mixture"},
  {name:"Salt & Pepper", bin:"Mixture"},
  {name:"White solid separated by dissolving + evaporating", bin:"Mixture"}
];
let sortState = [], sortCorrectCount = 0, selectedChip = null;

function startSort(){
  sortState = shuffle(sortItems).map(i => ({...i, placed:false}));
  sortCorrectCount = 0; selectedChip = null;
  document.getElementById('sort-score').textContent = `0 / ${sortState.length}`;
  document.getElementById('sort-hint').textContent = '\u00A0';
  ['bin-element','bin-compound','bin-mixture'].forEach(id => document.getElementById(id).innerHTML = '');
  renderSortTray();
}

function renderSortTray(){
  const tray = document.getElementById('sort-tray');
  tray.innerHTML = '';
  sortState.forEach((item, idx) => {
    if(item.placed) return;
    const chip = document.createElement('button');
    chip.className = 'sort-item';
    chip.textContent = item.name;
    chip.onclick = () => {
      document.querySelectorAll('.sort-item').forEach(c => c.classList.remove('selected'));
      chip.classList.add('selected');
      selectedChip = idx;
    };
    tray.appendChild(chip);
  });
}

document.querySelectorAll('.bin').forEach(bin => {
  bin.addEventListener('click', () => {
    if(selectedChip === null) {
      document.getElementById('sort-hint').textContent = "Tap a substance below first, then tap a bin.";
      return;
    }
    const item = sortState[selectedChip];
    const binName = bin.dataset.bin;
    const hint = document.getElementById('sort-hint');
    if(item.bin === binName){
      item.placed = true;
      sortCorrectCount++;
      const chipEl = document.createElement('span');
      chipEl.className = 'bin-chip';
      chipEl.textContent = item.name;
      bin.querySelector('.bin-items').appendChild(chipEl);
      hint.textContent = `✔ Correct — ${item.name} is a${/^[aeiou]/i.test(binName) ? 'n' : ''} ${binName.toLowerCase()}.`;
      document.getElementById('sort-score').textContent = `${sortCorrectCount} / ${sortState.length}`;
      renderSortTray();
      selectedChip = null;
      if(sortCorrectCount === sortState.length){
        hint.textContent = "🎉 All sorted correctly! Tap Reset lab to try again.";
      }
    } else {
      hint.textContent = `Not quite — ${item.name} doesn't belong in ${binName}. Try another bin.`;
    }
  });
});

