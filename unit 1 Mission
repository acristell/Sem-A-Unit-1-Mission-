const flashBank = [
  {term:"Atom", def:"The smallest unit of an element that still has that element's properties."},
  {term:"Element", def:"A pure substance made of only one type of atom. It cannot be broken down into simpler substances."},
  {term:"Compound", def:"Two or more different elements chemically bonded together (e.g., water = H₂O)."},
  {term:"Mixture", def:"Two or more substances combined but not chemically bonded — they can be separated by physical means, like salt and pepper."},
  {term:"Matter", def:"Anything that has mass and takes up space (volume)."},
  {term:"Physical Property", def:"A characteristic you can observe or measure without changing what the substance is — like melting point or color."},
  {term:"Chemical Property", def:"Describes how a substance reacts to form a new substance — like flammability or reacting with acid."},
  {term:"Physical Change", def:"A change in form or state where no new substance is formed — like ice melting into water."},
  {term:"Chemical Change", def:"A change that produces a brand-new substance with different properties — like rusting or burning."},
  {term:"Density", def:"How much mass is packed into a given volume. It's why a gold cube feels heavier than an aluminum cube of the same size."},
  {term:"pH Scale", def:"Measures how acidic or basic a substance is. Lower numbers = more acidic, higher numbers = more basic."},
  {term:"Malleable", def:"Can be hammered or pressed into thin sheets without cracking — a property of metals, like copper."},
  {term:"Ductile", def:"Can be pulled or stretched into thin wires — a property of metals, like aluminum."},
  {term:"Conductivity", def:"How well a material transfers heat or electric current."},
  {term:"Alloy", def:"A mixture of two or more metals melted together — like bronze, made from copper and tin."},
  {term:"Metalloid", def:"An element with properties of BOTH metals and non-metals."},
  {term:"Solution vs. Colloid", def:"In a solution, a light beam passes through invisibly. In a colloid, the beam scatters and becomes visible."},
  {term:"Law of Conservation of Mass", def:"In a closed system, mass stays the same during a reaction — atoms rearrange, but none are created or destroyed."}
];
